--- !u!114 &1403625129
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1403625128}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec31be4fac67ca645b18cb0881789f4d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvents
  eventTypesList:
  - name: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0432\u0438\u0440\u0443\u0441"
    description: "\u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
      \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u0432\u0438\u0440\u0443\u0441, \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E
      \u043C\u043D\u043E\u0433\u0438\u0435 \u0436\u0438\u0442\u0435\u043B\u0438 \u043F\u043E\u0433\u0438\u0431\u043B\u0438,
      \u0430 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0442\u0441\u0432\u0435\u043D\u043D\u0430\u044F
      \u043A\u0430\u0437\u043D\u0430 \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0430"
    coinsAmount: -5
    soldiersAmount: -1
    villagersAmount: -5
  - name: "\u0421\u0432\u0430\u0434\u044C\u0431\u0430"
    description: "\u0412 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0442\u0441\u0432\u0435
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A! \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
      \u0441\u0435\u043C\u044C\u044F \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u0430\u0441\u044C
      \u043D\u043E\u0432\u044B\u043C \u0446\u0435\u043D\u043D\u044B\u043C \u0441\u043E\u044E\u0437\u043E\u043C.
      \u0410\u0440\u043C\u0438\u044F \u043D\u043E\u0432\u044B\u0445 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432
      \u0443\u0441\u043F\u0435\u0448\u043D\u0430 \u0432\u043E\u0448\u043B\u0430 \u0432
      \u043D\u0430\u0448 \u0441\u043E\u0441\u0442\u0430\u0432, \u043D\u043E \u0437\u0430
      \u0442\u0430\u043A\u043E\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0442\u0434\u0430\u0442\u044C
      \u043D\u0435\u043C\u0430\u043B\u043E \u0437\u043E\u043B\u043E\u0442\u0430"
    coinsAmount: -20
    soldiersAmount: 2
    villagersAmount: 0
  - name: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
    description: "\u041D\u0430\u0433\u043B\u044B\u0435 \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u0438\u043A\u0438
      \u0438\u0437 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0442\u0441\u0432\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0446\u0435\u0440\u043A\u0432\u0438
      \u043E\u0442\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C \u043E\u0442 \u043D\u0430\u0441
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u044B\u0442\u0430\u044E\u0442\u0441\u044F
      \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0451 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E. \u041D\u0430
      \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043C\u0438\u0442\u0438\u043D\u0433\u043E\u0432
      \u0432 \u0441\u0442\u043E\u043B\u0438\u0446\u0435 \u0443\u0439\u0434\u0435\u0442
      \u043A\u0430\u043A\u043E\u0435 \u0442\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0441\u0438\u043B"
    coinsAmount: 0
    soldiersAmount: -3
    villagersAmount: -3
  - name: "\u0423\u0436\u0430\u0441\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430"
    description: "\u041D\u0430\u0448\u0438 \u043F\u043E\u0441\u043B\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u043B\u043E\u0445\u0438\u043C\u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438.
      \u041C\u043E\u0440\u0441\u043A\u0430\u044F \u0434\u0435\u0440\u0436\u0430\u0432\u0430
      \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043E\u0442 \u0441\u043E\u044E\u0437\u0430
      \u0441 \u043D\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u044B\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0437\u0430\u043A\u0440\u044B\u0442. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u043C\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443 \u0434\u0435\u043D\u0435\u0433"
    coinsAmount: -10
    soldiersAmount: 0
    villagersAmount: 0
  resourceManager: {fileID: 624640262}
