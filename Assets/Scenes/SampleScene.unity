  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u0438\u0433\u0440\u0430\u0442\u044C
    \u043D\u0430\u0436\u043C\u0438 \u0418\u0413\u0420\u0410\u0422\u042C\n\n\u041A\u0440\u0430\u0442\u043A\u0438\u0439
    \u0433\u0430\u0439\u0434:\n\u041D\u0443\u0436\u043D\u043E \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C
    \u0432\u043E\u043B\u043D\u044B \u0430\u0442\u0430\u043A, \u0442\u0430\u0439\u043C\u0435\u0440
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043A\u0440\u0430\u0441\u043D\u0430\u044F
    \u043B\u0438\u043D\u0438\u044F \u0441\u0432\u0435\u0440\u0445\u0443.\n\u041F\u0440\u043E\u0436\u0438\u043B
    10 \u0432\u043E\u043B\u043D = \u043F\u043E\u0431\u0435\u0434\u0438\u043B\n\u0423\u0448\u0435\u043B
    \u0432 \u0434\u043E\u043B\u0433 \u043D\u0430 20+ \u043C\u043E\u043D\u0435\u0442
    = \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\n\u0415\u0441\u043B\u0438
    \u0432\u044B \u043C\u0443\u0434\u0440\u0438\u043B\u0438\u0441\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439 \u0447\u0435\u043C
    \u0443 \u0432\u0430\u0441 \u0431\u044B\u043B\u043E - \u0437\u0430 \u043D\u0438\u0445
    \u0441\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043C\u043E\u043D\u0435\u0442\u044B\n\u041A\u0430\u0436\u0434\u044B\u0439
    \u0432\u043E\u0438\u043D \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0435\u0442
    \u043C\u043E\u043D\u0435\u0442\u044B, \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
    \u043F\u0440\u043E \u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430
    \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \"\u0421\u043E\u0431\u044B\u0442\u0438\u044F\" "
